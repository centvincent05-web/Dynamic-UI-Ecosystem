<Window x:Class="DynamicIsland.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Typography.NumeralAlignment="Tabular">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="SubtleText" Color="#B4B2A9"/>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="4,5,4,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#1F1F21"/>
        </Style>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18" Padding="18,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="Root">
        <!-- Ambient light: cahaya lembut mengikuti warna cover lagu -->
        <Path x:Name="Glow" Fill="Black" Opacity="0" IsHitTestVisible="False">
            <Path.Effect>
                <DropShadowEffect x:Name="GlowEffect" ShadowDepth="0" BlurRadius="28" Color="Black" Opacity="1" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- Bentuk notch (digambar ulang per frame hanya saat animasi) -->
        <Path x:Name="Shape" Fill="Black"/>
        <!-- saat terbuka island sedikit lebih pekat supaya isinya tetap terbaca di atas wallpaper yang ramai -->
        <Path x:Name="ShapeBoost" Fill="Black" Opacity="0" IsHitTestVisible="False"/>
        <!-- garis tepi tipis ala macOS (dipasang di atas isi, lihat Edge di bawah) -->

        <!-- Isi island, dipotong (clip) mengikuti bentuk notch -->
        <Canvas x:Name="Layer">
            <!-- ambient light di dalam island: semburat warna cover, di bawah semua isi -->
            <Rectangle x:Name="InnerGlow" IsHitTestVisible="False" Opacity="0"/>
            <!-- cahaya lembut yang mengikuti pointer saat hover (dipotong mengikuti bentuk island) -->
            <Ellipse x:Name="Spotlight" Width="280" Height="280" IsHitTestVisible="False" Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="SpotlightCenter" Color="#24FFFFFF" Offset="0"/>
                        <GradientStop x:Name="SpotlightMid" Color="#0BFFFFFF" Offset="0.45"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- garis hijau yang menelusuri tepi notch saat charger dicolok / dicabut -->
            <Canvas x:Name="ChargeRimLayer" IsHitTestVisible="False" Visibility="Hidden">
                <Path x:Name="RimGlowL" Stroke="#34C759" StrokeThickness="14" Opacity="0.22" StrokeDashCap="Round"/>
                <Path x:Name="RimGlowR" Stroke="#34C759" StrokeThickness="14" Opacity="0.22" StrokeDashCap="Round"/>
                <Path x:Name="RimL" Stroke="#34C759" StrokeThickness="5" StrokeDashCap="Round"/>
                <Path x:Name="RimR" Stroke="#34C759" StrokeThickness="5" StrokeDashCap="Round"/>
            </Canvas>

            <!-- ===== Notch kecil: bar musik | jam / timer | cover atau baterai ===== -->
            <Grid x:Name="Mini">
                <TextBlock x:Name="MiniWifi" Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,2"/>
                <!-- Discord dalam panggilan: ikon di kiri, cincin hijau menyala saat ada yang bicara -->
                <Grid x:Name="MiniDiscord" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,2"
                      Width="22" Height="22" Opacity="0" ToolTip="Discord">
                    <Ellipse x:Name="MiniDiscordRing" Stroke="#3BA55D" StrokeThickness="2" Opacity="0"/>
                    <Image x:Name="MiniDiscordIcon" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <EllipseGeometry Center="8,8" RadiusX="8" RadiusY="8"/>
                        </Image.Clip>
                    </Image>
                </Grid>
                <StackPanel x:Name="MiniBars" Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="14,0,0,2" Height="14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2">
                    <TextBlock x:Name="MiniBell" Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="#FF5A4E" VerticalAlignment="Center" Margin="0,1,5,0" Visibility="Collapsed"/>
                    <Grid>
                        <TextBlock x:Name="MiniClock" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                        <!-- panggilan (hijau) / rekam layar (merah) + durasi: di kiri jam, tanpa menggeser jam -->
                        <Border x:Name="MiniLive" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="7"
                                Padding="6,1,7,1" Visibility="Collapsed" Background="#3334C759">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="MiniLiveShift"/>
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="MiniLiveIcon" FontFamily="{StaticResource IconFont}" FontSize="9.5" Foreground="#34C759"
                                           VerticalAlignment="Center" Margin="0,1,4,0"/>
                                <TextBlock x:Name="MiniLiveText" FontSize="11" FontWeight="SemiBold" Foreground="#34C759" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- titik kamera (hijau) / mikrofon (oranye): di kanan jam, tanpa menggeser jam dari tengah -->
                        <StackPanel x:Name="MiniPrivacy" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,1,0,0" Visibility="Collapsed" Background="Transparent">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="MiniPrivacyShift"/>
                            </StackPanel.RenderTransform>
                            <Ellipse x:Name="MiniCamDot" Width="6" Height="6" Fill="#34C759"/>
                            <Ellipse x:Name="MiniMicDot" Width="6" Height="6" Fill="#FF9F0A" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Image x:Name="MiniArt" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,14,2" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,18,18" RadiusX="5" RadiusY="5"/>
                    </Image.Clip>
                </Image>
                <TextBlock x:Name="MiniInfo" Foreground="{StaticResource SubtleText}" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,2"/>
                <!-- garis hijau saat mengisi daya, panjangnya = persentase baterai -->
                <Grid x:Name="ChargeTrack" Height="2.5" VerticalAlignment="Bottom" Margin="18,0,18,3" Visibility="Collapsed">
                    <Border x:Name="ChargeTrackBg" CornerRadius="1.25" Background="#2634C759"/>
                    <Border x:Name="ChargeFill" CornerRadius="1.25" Background="#34C759" HorizontalAlignment="Left" Width="0"/>
                </Grid>
            </Grid>

            <!-- ===== Animasi charger dicolok / dicabut ===== -->
            <Grid x:Name="ChargeAlert" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,2">
                    <TextBlock x:Name="AlertBolt" Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="#34C759" VerticalAlignment="Center" Margin="0,1,6,0">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="AlertBoltScale" CenterX="6" CenterY="8"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="AlertLabel" Text="Mengisi daya" Foreground="White" FontSize="12.5"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,2">
                    <TextBlock x:Name="AlertPercent" Text="0%" Foreground="#34C759" FontSize="12.5" FontWeight="SemiBold"
                               MaxWidth="130" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Grid x:Name="AlertBattery" Width="27" Height="13" VerticalAlignment="Center">
                        <Border Width="24" HorizontalAlignment="Left" CornerRadius="3.5" BorderThickness="1.3" BorderBrush="#73FFFFFF"/>
                        <Border x:Name="AlertBatFill" HorizontalAlignment="Left" Margin="2.3,2.3,0,2.3" CornerRadius="1.8"
                                Background="#34C759" Width="0"/>
                        <Border Width="2" Height="5" HorizontalAlignment="Right" CornerRadius="1" Background="#73FFFFFF" Margin="0,0,0.5,0"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ===== Halaman 1: player musik (hover di cover lagu) ===== -->
            <Grid x:Name="MediaView" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="MediaScale" ScaleX="0.92" ScaleY="0.92"/>
                </Grid.RenderTransform>
                <Grid Margin="18,12,18,12">
                    <TextBlock x:Name="NoMediaText" Text="Tidak ada media yang diputar"
                               Foreground="{StaticResource SubtleText}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid x:Name="MediaPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ArtPlaceholder" Width="52" Height="52" CornerRadius="12" Background="#D85A30">
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image x:Name="ArtImage" Width="52" Height="52" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,52,52" RadiusX="12" RadiusY="12"/>
                                </Image.Clip>
                            </Image>
                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ArtistText" Foreground="{StaticResource SubtleText}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                <TextBlock x:Name="SourceText" FontSize="10.5" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel x:Name="FullBars" Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Top" Margin="0,6,0,0" Height="20"/>
                        </Grid>

                        <!-- 0:22 ───── -2:29 (klik bar untuk lompat) -->
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PosText" Foreground="{StaticResource SubtleText}" FontSize="11" VerticalAlignment="Center"/>
                            <Border x:Name="SeekArea" Grid.Column="1" Height="14" Background="Transparent" Cursor="Hand">
                                <Grid VerticalAlignment="Center">
                                    <Border Height="4" CornerRadius="2" Background="#444441"/>
                                    <Border x:Name="TrackFill" Height="4" CornerRadius="2" Background="White"
                                            HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="DurText" Grid.Column="2" Foreground="{StaticResource SubtleText}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- volume | prev pause next | output suara -->
                        <Grid Grid.Row="2" VerticalAlignment="Center">
                            <Button x:Name="MediaVolumeButton" Style="{StaticResource IconButton}" Content="&#xE767;" FontSize="15"
                                    HorizontalAlignment="Left" ToolTip="Scroll: volume  ·  Klik: mute"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="17"/>
                                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                        FontSize="22" Margin="10,0"/>
                                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="17"/>
                            </StackPanel>
                            <Button x:Name="OutputButton" Style="{StaticResource IconButton}" Content="&#xE7F6;" FontSize="15"
                                    HorizontalAlignment="Right" ToolTip="Pilih output suara"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ===== Halaman 2: control center (hover di jam) ===== -->
            <Grid x:Name="ControlView" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ControlScale" ScaleX="0.92" ScaleY="0.92"/>
                </Grid.RenderTransform>
                <Grid Margin="16,9,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CPU | jam | RAM baterai -->
                    <Grid Height="22" Margin="4,0">
                        <!-- stat laptop yang dipilih di Settings (ikon + angka), dibagi kiri & kanan jam -->
                        <StackPanel x:Name="StatsLeft" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderBell" Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="#FF5A4E" VerticalAlignment="Center" Margin="0,1,5,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="HeaderClock" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel x:Name="StatsRight" Orientation="Horizontal"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4 tile besar -->
                    <UniformGrid Grid.Row="1" Rows="2" Columns="2" Margin="0,8,0,0">
                        <Border x:Name="WifiTile" Style="{StaticResource Tile}" Height="46" ToolTip="Klik: nyala/mati  ·  Klik kanan: pengaturan">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Width="26"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Wi-Fi" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="WifiSub" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DockTile" Style="{StaticResource Tile}" Height="46" ToolTip="Smart: dock sembunyi saat ada jendela maximize">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                <TextBlock Text="&#xE75B;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Width="26"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mode dock" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DockSub" FontSize="10" Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="BluetoothTile" Style="{StaticResource Tile}" Height="46" ToolTip="Klik: nyala/mati  ·  Klik kanan: pengaturan">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Width="26"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bluetooth" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BluetoothSub" FontSize="10" Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="NotchTile" Style="{StaticResource Tile}" Height="46" ToolTip="Notch selalu tampil atau sembunyi otomatis">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Width="26"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mode notch" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="NotchSub" FontSize="10" Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- tombol bulat (2 baris) -->
                    <UniformGrid Grid.Row="2" Rows="2" Columns="5" Margin="0,8,0,0">
                        <Button x:Name="DndButton" Style="{StaticResource RoundButton}" Content="&#xE708;" ToolTip="Jangan ganggu" Margin="0,0,0,8"/>
                        <Button x:Name="SaverButton" Style="{StaticResource RoundButton}" Content="&#xE83F;" ToolTip="Hemat baterai" Margin="0,0,0,8"/>
                        <Button x:Name="AirplaneButton" Style="{StaticResource RoundButton}" Content="&#xE709;" ToolTip="Mode pesawat" Margin="0,0,0,8"/>
                        <Button x:Name="NightLightButton" Style="{StaticResource RoundButton}" Content="&#xE793;" ToolTip="Night light" Margin="0,0,0,8"/>
                        <Button x:Name="HiddenIconsButton" Style="{StaticResource RoundButton}" Content="&#xE70E;" ToolTip="Ikon tersembunyi (system tray)" Margin="0,0,0,8"/>
                        <Button x:Name="CastButton" Style="{StaticResource RoundButton}" Content="&#xEC15;" ToolTip="Cast ke layar lain"/>
                        <Button x:Name="ProjectButton" Style="{StaticResource RoundButton}" Content="&#xE7F4;" ToolTip="Project (mode layar kedua)"/>
                        <Button x:Name="AppsButton" Style="{StaticResource RoundButton}" Content="&#xE71D;" ToolTip="Semua aplikasi"/>
                        <Button x:Name="NotifButton" Style="{StaticResource RoundButton}" Content="&#xEA8F;" ToolTip="Pusat notifikasi"/>
                        <Button x:Name="SettingsButton" Style="{StaticResource RoundButton}" Content="&#xE713;" ToolTip="Pengaturan island"/>
                    </UniformGrid>

                    <!-- slider berlabel: scroll atau klik -->
                    <StackPanel Grid.Row="3" Margin="4,10,4,0">
                        <Grid x:Name="VolumeRow" Height="24" Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VolumeIcon" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{StaticResource SubtleText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Volume" Foreground="{StaticResource SubtleText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Grid x:Name="VolumeTrack" Grid.Column="2" Height="20" VerticalAlignment="Center" Background="Transparent">
                                <Border Height="6" CornerRadius="3" Background="#333335"/>
                                <Border x:Name="VolumeFill" Height="6" CornerRadius="3" Background="White" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock x:Name="VolumeText" Grid.Column="3" Foreground="{StaticResource SubtleText}" FontSize="11"
                                       FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="BrightnessRow" Height="24" Margin="0,4,0,0" Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{StaticResource SubtleText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Kecerahan" Foreground="{StaticResource SubtleText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Grid x:Name="BrightnessTrack" Grid.Column="2" Height="20" VerticalAlignment="Center" Background="Transparent">
                                <Border Height="6" CornerRadius="3" Background="#333335"/>
                                <Border x:Name="BrightnessFill" Height="6" CornerRadius="3" Background="White" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock x:Name="BrightnessText" Grid.Column="3" Foreground="{StaticResource SubtleText}" FontSize="11"
                                       FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===== Halaman 3: kalender + timer (scroll dari control center) ===== -->
            <Grid x:Name="CalendarView" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="CalendarScale" ScaleX="0.92" ScaleY="0.92"/>
                </Grid.RenderTransform>
                <Grid Margin="18,9,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- jadwal hari ini dari Google Calendar -->
                    <Border x:Name="CalEventsBox" Grid.Row="2" Background="#C01F1F21" CornerRadius="10" Padding="10,5" Margin="0,8,0,0"
                            Cursor="Hand" Visibility="Collapsed">
                        <TextBlock x:Name="CalEvents" Foreground="White" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Grid Height="22">
                        <TextBlock x:Name="CalDateText" Foreground="{StaticResource SubtleText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CalClockText" Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- kalender sederhana: hari, tanggal besar, bulan, minggu ini -->
                        <StackPanel x:Name="CalendarBox" Margin="4,0,14,0" VerticalAlignment="Center" Background="Transparent"
                                    Cursor="Hand" ToolTip="Buka Google Calendar">
                            <TextBlock x:Name="DayName" FontSize="14" FontWeight="SemiBold" Foreground="#FF5A4E"/>
                            <TextBlock x:Name="DayNumber" FontSize="50" FontWeight="Bold" Foreground="White"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Margin="-2,-6,0,-6"/>
                            <TextBlock x:Name="MonthTitle" FontSize="13" Foreground="{StaticResource SubtleText}"/>
                            <UniformGrid x:Name="WeekStrip" Columns="7" Margin="0,12,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#2C2C2E"/>

                        <!-- timer -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock x:Name="TimerHint" Text="Scroll angka untuk mengubah" Foreground="{StaticResource SubtleText}"
                                       FontSize="10.5" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TimerText" Foreground="White" FontSize="40" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" HorizontalAlignment="Center"
                                       Background="Transparent" Cursor="SizeNS" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="TimerStartButton" Style="{StaticResource PillButton}" Content="▶  Mulai" MinWidth="104"/>
                                <Button x:Name="TimerResetButton" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="14"
                                        Width="34" Margin="6,0,0,0" Foreground="{StaticResource SubtleText}" ToolTip="Ulang"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button x:Name="Preset5" Style="{StaticResource ChipButton}" Content="5"/>
                                <Button x:Name="Preset15" Style="{StaticResource ChipButton}" Content="15"/>
                                <Button x:Name="Preset25" Style="{StaticResource ChipButton}" Content="25"/>
                                <Button x:Name="Preset50" Style="{StaticResource ChipButton}" Content="50"/>
                                <Button x:Name="PomodoroButton" Style="{StaticResource ChipButton}" Content="🍅" ToolTip="Pomodoro: 25 menit fokus, 5 menit istirahat"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ===== Daftar Wi-Fi / Bluetooth (klik kanan / klik dua jari di tile) ===== -->
            <Grid x:Name="NetListView" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="NetListScale" ScaleX="0.95" ScaleY="0.95"/>
                </Grid.RenderTransform>
                <Grid Margin="14,8,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Height="28">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NetBackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="13" Width="30" Height="28" ToolTip="Kembali"/>
                            <TextBlock x:Name="NetListTitle" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="NetSettingsButton" Style="{StaticResource ChipButton}" Content="Pengaturan"/>
                            <Button x:Name="NetRefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="13" Width="30" Height="28" ToolTip="Pindai ulang"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="NetStatusText" Grid.Row="1" Foreground="{StaticResource SubtleText}" FontSize="11" Margin="6,2,6,4"
                               TextWrapping="Wrap"/>
                    <!-- kotak password (muncul saat jaringan butuh password) -->
                    <Border x:Name="PasswordPanel" Grid.Row="1" Visibility="Collapsed" Background="#1F1F21" CornerRadius="12" Padding="10,8" Margin="2,2,2,6">
                        <StackPanel>
                            <TextBlock x:Name="PasswordLabel" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <PasswordBox x:Name="PasswordInput" Height="30" FontSize="13" Padding="8,4" Margin="0,0,120,0"
                                             Background="#2C2C2E" Foreground="White" BorderThickness="0" CaretBrush="White"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="PasswordConnect" Style="{StaticResource PillButton}" Content="Sambung" FontSize="12"/>
                                    <Button x:Name="PasswordCancel" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" Width="30" Height="30"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Margin="0,2,0,0">
                        <StackPanel x:Name="NetRows"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ===== Halaman: notifikasi Windows (Chrome, Phone Link, dll.) ===== -->
            <Grid x:Name="NotifView" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="NotifScale" ScaleX="0.95" ScaleY="0.95"/>
                </Grid.RenderTransform>
                <Grid Margin="14,8,14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Height="28" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="NotifTitle" Text="Notifikasi" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NotifCount" Foreground="{StaticResource SubtleText}" FontSize="12" VerticalAlignment="Center" Margin="8,1,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="NotifClearButton" Style="{StaticResource ChipButton}" Content="Hapus semua"/>
                            <Button x:Name="NotifCenterButton" Style="{StaticResource IconButton}" Content="&#xE8A7;" FontSize="13" Width="30" Height="28" ToolTip="Buka pusat notifikasi Windows"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="NotifEmpty" Grid.Row="1" Text="Belum ada notifikasi" Foreground="{StaticResource SubtleText}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <ScrollViewer x:Name="NotifScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,4,0,0">
                        <StackPanel x:Name="NotifRows"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ===== Halaman: performa laptop (seperti Task Manager) ===== -->
            <Grid x:Name="PerfView" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="PerfScale" ScaleX="0.95" ScaleY="0.95"/>
                </Grid.RenderTransform>
                <Grid Margin="14,8,14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Height="28" Margin="4,0,0,0">
                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,1,8,0"/>
                        <TextBlock x:Name="PerfTitle" Text="Performa" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <UniformGrid x:Name="PerfGrid" Grid.Row="1" Columns="2" Margin="0,4,0,0"/>
                </Grid>
            </Grid>

            <Grid x:Name="ShelfView" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ShelfScale" ScaleX="0.95" ScaleY="0.95"/>
                </Grid.RenderTransform>
                <Grid Margin="14,8,14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Height="28" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="ShelfTitle" Text="Shelf" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ShelfClearButton" Style="{StaticResource ChipButton}" Content="Hapus semua"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ShelfEmpty" Grid.Row="1" Text="Tarik file ke notch untuk disimpan sementara, lalu tarik keluar ke aplikasi lain"
                               Foreground="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0"/>
                    <ScrollViewer x:Name="ShelfScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,6,0,0">
                        <WrapPanel x:Name="ShelfTiles"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="ClipView" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ClipScale" ScaleX="0.95" ScaleY="0.95"/>
                </Grid.RenderTransform>
                <Grid Margin="14,8,14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Height="28" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="ClipTitle" Text="Clipboard" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ClipClearButton" Style="{StaticResource ChipButton}" Content="Hapus semua"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ClipEmpty" Grid.Row="1" Text="Teks yang kamu salin akan muncul di sini (hanya di memori, tidak disimpan)"
                               Foreground="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0"/>
                    <ScrollViewer x:Name="ClipScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,4,0,0">
                        <StackPanel x:Name="ClipRows"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="GeminiView" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="GeminiScale" ScaleX="0.95" ScaleY="0.95"/>
                </Grid.RenderTransform>
                <Grid Margin="14,8,14,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Height="28" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE99A;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="GeminiTitle" Text="Gemini" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="GeminiNewButton" Style="{StaticResource ChipButton}" Content="Obrolan baru"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="GeminiScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,4,0,6">
                        <StackPanel x:Name="GeminiMessages"/>
                    </ScrollViewer>
                    <StackPanel x:Name="GeminiNoKey" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="GeminiNoKeyText" Text="Masukkan API key Gemini di Pengaturan → Gemini" Foreground="{StaticResource SubtleText}"
                                   FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="GeminiKeyButton" Style="{StaticResource PillButton}" Content="Dapatkan API key gratis" FontSize="12"
                                Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#2C2C2E" CornerRadius="16" Padding="12,2,4,2">
                        <Grid>
                            <TextBox x:Name="GeminiInput" Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0"
                                     FontSize="12.5" VerticalContentAlignment="Center" MinHeight="30" MaxHeight="80" TextWrapping="Wrap"
                                     AcceptsReturn="False" Margin="0,0,40,0"/>
                            <TextBlock x:Name="GeminiPlaceholder" Text="Tanya Gemini…" Foreground="#77777A" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                            <Button x:Name="GeminiSend" Style="{StaticResource IconButton}" Content="&#xE724;" FontSize="13"
                                    Width="32" Height="28" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- volume / kecerahan di notch (saat tombol keyboard ditekan) -->
            <Grid x:Name="HudPeek" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                <Grid Margin="20,0,20,2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HudIcon" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                               VerticalAlignment="Center" Width="20"/>
                    <Grid x:Name="HudTrack" Grid.Column="1" Height="5" Margin="8,0,12,0" VerticalAlignment="Center">
                        <Border CornerRadius="2.5" Background="#38FFFFFF"/>
                        <Border x:Name="HudFill" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock x:Name="HudText" Grid.Column="2" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                               MinWidth="36" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- notifikasi baru: muncul sebentar di notch -->
            <Grid x:Name="NotifPeek" Opacity="0" Visibility="Hidden" Cursor="Hand">
                <Grid Margin="16,9,16,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="#2C2C2E" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="NotifPeekIcon" Width="34" Height="34" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- ikon perangkat Bluetooth (dipakai sebagai ganti gambar aplikasi) -->
                            <TextBlock x:Name="NotifPeekGlyph" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock x:Name="NotifPeekApp" Foreground="{StaticResource SubtleText}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotifPeekTitle" Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotifPeekBody" Foreground="#DDDDDD" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- titik penanda halaman -->
            <StackPanel x:Name="PageDots" Orientation="Horizontal" IsHitTestVisible="False" Opacity="0"/>
        </Canvas>
        <Path x:Name="Edge" Stroke="#1FFFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
    </Canvas>
</Window>
