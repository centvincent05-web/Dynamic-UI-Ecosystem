<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Exe kecil khusus live wallpaper, supaya di Task Manager namanya jelas:
    "Dynamic Island – Live wallpaper" (DynamicIsland.LiveWallpaper.exe).
    Semua kodenya memakai DynamicIsland.dll (proyek utama) — tidak ada kode yang digandakan,
    dan RAM-nya sama seperti sebelumnya (video memang sudah berjalan di proses terpisah).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\app.ico</ApplicationIcon>
    <AssemblyName>DynamicIsland.LiveWallpaper</AssemblyName>
    <RootNamespace>DynamicIsland.LiveWallpaper</RootNamespace>
    <AssemblyTitle>Dynamic Island – Live wallpaper</AssemblyTitle>
    <Product>Dynamic Island</Product>
    <Version>0.9.1</Version>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- keluaran ke folder yang sama dengan DynamicIsland.exe -->
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicIsland.csproj" />
  </ItemGroup>

</Project>
